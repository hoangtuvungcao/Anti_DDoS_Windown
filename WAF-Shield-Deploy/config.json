{
  // ==============================================================================
  //           CẤU HÌNH HỆ THỐNG WAF ANTI-DDOS ENTERPRISE CHO WINDOWS
  // ==============================================================================

  // Số luồng worker xử lý gói tin song song (0 = Tự động nhận diện số nhân CPU máy chủ)
  "workers": 0,

  // Đường dẫn file lưu nhật ký sự kiện bảo mật (Tự động xoay file khi đạt 10MB)
  "log_file": "resources/logs/shield.log",

  // Chế độ hoạt động của WAF:
  // "AUTO"  : Tự động thích ứng (Thời bình chạy Peace, khi bị DDoS tự bật War Mode) - KHUYÊN DÙNG
  // "WAR"   : Luôn bật chế độ phòng thủ nghiêm ngặt nhất 24/7
  // "PEACE" : Chế độ bình thường, chỉ áp dụng giới hạn cơ bản
  "system_mode": "AUTO",

  // ------------------------------------------------------------------------------
  // 1. CẤU HÌNH THỜI BÌNH (PEACE MODE - LƯU LƯỢNG BÌNH THƯỜNG)
  // ------------------------------------------------------------------------------
  "peace_mode": {
    // PEACE/ELEVATED chỉ giám sát, không can thiệp traffic hợp lệ của The Isle,
    // Steam query, RCON, IslePilot, VoIP hoặc UltraViewer.
    "monitor_only": true,

    // Giới hạn gói tin UDP tối đa trên mỗi luồng IP:Port (Gói tin/giây - PPS)
    "udp_pps_per_flow": 500,

    // Giới hạn băng thông UDP tối đa trên mỗi luồng (Bytes/giây, 5242880 = 5 MB/s)
    "udp_bps_per_flow": 5242880,

    // Giới hạn tổng gói tin UDP tối đa từ 1 địa chỉ IP (PPS)
    "udp_pps_per_ip": 1500,

    // Giới hạn gói tin tổng cộng từ cùng một dải mạng Subnet /24 (Chống botnet phân tán)
    "subnet_pps_limit": 5000,

    // Thời gian khóa tạm thời IP vi phạm nặng (Giây, 30 = 30 giây)
    "blacklist_duration_sec": 30,

    // Số kết nối TCP đồng thời tối đa cho phép từ 1 địa chỉ IP
    "tcp_max_conn_per_ip": 150,

    // Tốc độ tạo kết nối TCP mới tối đa từ 1 IP (Kết nối/giây - Chống SYN Flood)
    "tcp_conn_rate_per_ip": 60,

    // Số kết nối TCP đồng thời tối đa cho phép từ cùng một dải mạng /24
    "tcp_max_conn_per_subnet": 500,

    // Thời gian ngắt kết nối TCP không có dữ liệu (Giây, mặc định 90 giây)
    "tcp_idle_timeout_sec": 90,

    // Tự động chặn các đòn tấn công khuếch đại UDP (DNS 53, NTP 123, SSDP 1900, Memcached 11211...)
    "enable_amplification_filter": true,

    // Không áp DPI ở thời bình; WAR có chính sách DPI riêng bên dưới.
    "enable_dpi_shield": false,

    // Nhận diện và đo query game; monitor_only bảo đảm không chặn lúc PEACE/ELEVATED.
    "enable_game_shield": true
  },


  // ------------------------------------------------------------------------------
  // 2. CẤU HÌNH THỜI CHIẾN (WAR MODE - KÍCH HOẠT KHI BỊ DDOS)
  // ------------------------------------------------------------------------------
  "war_mode": {
    // Ngưỡng lưu lượng kích hoạt War Mode (PPS máy chủ nhận được vượt mức này sẽ bật War)
    "trigger_pps": 15000,

    // Ngưỡng băng thông kích hoạt War Mode (Bytes/giây, 52428800 = 50 MB/s)
    "trigger_bps": 52428800,

    // Thời gian duy trì War Mode sau khi đợt tấn công kết thúc trước khi về Peace (Giây)
    "cooldown_sec": 60,

    // Giới hạn UDP siết chặt trên mỗi luồng khi đang bị tấn công (PPS)
    "udp_pps_per_flow": 250,

    // Giới hạn băng thông mỗi luồng khi có tấn công (2 MB/s)
    "udp_bps_per_flow": 2097152,

    // Giới hạn tổng UDP siết chặt từ 1 IP khi đang bị tấn công (PPS)
    "udp_pps_per_ip": 600,

    // Giới hạn tổng UDP từ 1 dải /24 khi đang bị tấn công (PPS)
    "subnet_pps_limit": 2500,

    // Bật kiểm tra mẫu chữ ký gói tin sâu (DPI)
    "enable_dpi": true,

    // Chế độ phân tích Shannon Entropy để lọc gói tin rác ngẫu nhiên ("AUTO", "ON", "OFF")
    "entropy_mode": "AUTO",

    // Xác thực phản hồi hai chiều (Two-Way Handshake Verification)
    "enable_twoway": true,

    // Tắt Geo-IP để không cắt IslePilot, Steam/EOS, VoIP và người chơi quốc tế
    "geoip_mode": "OFF",

    // Ưu tiên tuyệt đối danh sách Whitelist không bị giới hạn tốc độ
    "strict_whitelist": true
  },


  // ------------------------------------------------------------------------------
  // 3. TỐI ƯU BỘ NHỚ VÀ BỘ ĐỆM (CACHE & MEMORY TUNING)
  // ------------------------------------------------------------------------------
  "cache": {
    // Số lượng bản ghi IP và luồng tối đa lưu trong RAM
    "max_entries": 300000,

    // Thời gian sống của bản ghi không hoạt động (Giây)
    "ttl_sec": 30,

    // Chu kỳ dọn dẹp bộ nhớ RAM định kỳ (Giây)
    "sweep_interval_sec": 10,

    // Số phân mảnh bản đồ khóa (Shards) để tối ưu đa luồng không bị nghẽn khóa
    "shards": 64
  },

  // ------------------------------------------------------------------------------
  // 4. TỰ ĐỘNG PHÁT HIỆN PORT (PORT DISCOVERY SCANNER)
  // ------------------------------------------------------------------------------
  "discovery": {
    // Chu kỳ quét socket hệ thống để cập nhật các port đang lắng nghe (Giây)
    "interval_sec": 5,

    // Danh sách các port loại trừ không áp dụng lọc (ví dụ: [80, 443])
    "exclude_ports": []
  },

  // ------------------------------------------------------------------------------
  // 5. GIAO DIỆN WEB DASHBOARD DARK-MODE (TRUY CẬP TỪ XA QUA TRÌNH DUYỆT)
  // ------------------------------------------------------------------------------
  "web_dashboard": {
    // Bật/Tắt Web Dashboard trực tuyến (http://IP_SERVER:8080)
    "enabled": true,
    // Cổng truy cập Web Dashboard
    "port": 8080,
    // Tên đăng nhập (để trống nếu không muốn đặt mật khẩu)
    "username": "",
    // Mật khẩu bảo vệ
    "password": "",
    // Cho phép truy cập từ mạng LAN / Internet (true) hoặc chỉ Localhost (false)
    "allow_lan": false
  },

  // ------------------------------------------------------------------------------
  // 6. THÔNG BÁO TẤN CÔNG TỨC THÌ QUA DISCORD / TELEGRAM WEBHOOK
  // ------------------------------------------------------------------------------
  "notifications": {
    // Bật/Tắt tính năng thông báo tự động khi có DDoS
    "enabled": false,
    // Đường dẫn Discord Webhook (Ví dụ: "https://discord.com/api/webhooks/...")
    "discord_webhook_url": "",
    // Token Telegram Bot (Ví dụ: "123456789:ABCdefGhIJKlmNoPQRstuVWXyz")
    "telegram_bot_token": "",
    // ID nhóm hoặc chat Telegram nhận tin (Ví dụ: "-1001234567890")
    "telegram_chat_id": "",
    // Thời gian giãn cách giữa các lần gửi tin để tránh spam (Giây)
    "cooldown_sec": 30
  },

  // ------------------------------------------------------------------------------
  // 7. LUẬT TÙY BIẾN CHO PORT ĐẶC BIỆT (CUSTOM SIGNATURE RULES)
  // ------------------------------------------------------------------------------
  "custom_rules": [],

  // ------------------------------------------------------------------------------
  // 8. DANH SÁCH IP TIN CẬY & DANH SÁCH ĐEN VĨNH VIỄN
  // ------------------------------------------------------------------------------
  // Danh sách IP tin cậy (Không bao giờ bị chặn/giới hạn)
  "whitelist_ips": [
    "127.0.0.1"
  ],

  // Danh sách IP hoặc dải mạng bị chặn vĩnh viễn (Layer 0 Drop ngay lập tức)
  "blacklist_ips": []
}
